APP_IMAGE=ghcr.io/island0515/tds-to-report:latest
LIBREOFFICE_IMAGE=linuxserver/libreoffice:latest

APP_PORT=8101
TZ=Asia/Shanghai

MAX_UPLOAD_MB=80
MAX_TDS_FILES=10
FILE_TTL_HOURS=24

DOC_CONVERSION_TIMEOUT_SECONDS=150
CONVERTER_TIMEOUT_SECONDS=120

DOC_CONVERTER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

BLANK_TEMPLATE_FILE=
